# Copie para config.env e ajuste para ESTA vps antes de rodar ./harden.sh
#   cp config.env.example config.env && vim config.env && ./harden.sh
#
# harden.sh regenera os arquivos derivados destas variáveis a cada execução
# (é seguro rodar de novo depois de mudar algo aqui).

# --- SSH ---
SSH_PORT=2233
ADMIN_USER=admin
# Usuários com permissão de login via SSH (vira "AllowUsers" no sshd_config).
# Separe múltiplos por espaço: "admin outrouser"
SSH_ALLOW_USERS="$ADMIN_USER"

# --- Firewall (UFW) ---
# Portas liberadas além da SSH_PORT (sempre liberada automaticamente).
UFW_EXTRA_ALLOW=(
  "80/tcp"
  "443/tcp"
  # "51820/udp"   # descomente se essa VPS também roda WireGuard
)

# --- fail2ban ---
F2B_BANTIME=24h
F2B_FINDTIME=10m
F2B_MAXRETRY=3
# IMPORTANTE: o jail do sshd usa SSH_PORT explicitamente (nunca "port = ssh")
# — ver README.md, seção "Erro que já pegamos uma vez", pra entender por quê.

# --- Docker: correção do vazamento pelo UFW ---
# Interface de rede voltada pra internet desta VPS. Muitas VPS NÃO usam eth0
# (ens3, enp1s0...). Descubra com: ip -o route get 1.1.1.1
# O script aborta se a interface não existir.
EXTERNAL_IFACE=eth0
# Faixa usada pelas redes de container (o padrão do Docker cobre 172.17-172.31).
DOCKER_NET_RANGE=172.16.0.0/12
# Portas de container que DEVEM ficar públicas na internet (0.0.0.0).
# Tudo que não estiver aqui é bloqueado por padrão nessa faixa — inclusive
# publicações futuras que alguém esquecer de restringir a 127.0.0.1.
# Formato: "porta_do_host/protocolo descrição" — a porta que aparece à
# esquerda em `docker ps` (0.0.0.0:8883->8883/tcp → "8883/tcp").
# Não use o IP do container: ele muda quando o container é recriado ou
# quando os containers sobem em outra ordem no boot.
DOCKER_PUBLIC_PORTS=(
  # "8883/tcp mqtt-tls"
)
